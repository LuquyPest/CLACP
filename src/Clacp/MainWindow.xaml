<Window x:Class="Clacp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Clacp"
        mc:Ignorable="d"
        Title="Clacp" Height="560" Width="760"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        StateChanged="OnStateChanged"
        Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Clacp" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="gestionnaire de mots de passe" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="10,4,0,0"/>
        </StackPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="1" SelectionChanged="OnTabControlSelectionChanged">
            <TabItem x:Name="CoffreTab" Header="COFFRE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="AddButton" Content="Ajouter" Margin="0,0,10,0" Click="OnAddClick"/>
                        <Button x:Name="EditButton" Content="Modifier" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnEditClick"/>
                        <Button x:Name="DeleteButton" Content="Supprimer" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0" Click="OnDeleteClick"/>
                        <Button x:Name="LockButton" Content="Verrouiller" Style="{StaticResource SecondaryButtonStyle}" Click="OnLockClick"/>
                    </StackPanel>

                    <DataGrid x:Name="EntriesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" MouseDoubleClick="OnEditClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TITRE" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="NOM D'UTILISATEUR" Binding="{Binding Username}" Width="2*"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="ParametresTab" Header="PARAMETRES">
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                        <TextBlock Text="Apparence" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Choisissez entre le theme sombre ou clair." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <ToggleButton x:Name="ThemeToggle" HorizontalAlignment="Left" Width="140"
                                      Checked="OnThemeToggleChanged" Unchecked="OnThemeToggleChanged"/>

                        <TextBlock Text="Fonctionnalite coffre de mots de passe" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="Active la liste d'entrees (onglet Coffre) et la recherche par raccourci. Desactivee, seul le raccourci presse-papiers fonctionne." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ToggleButton x:Name="VaultEnabledToggle" HorizontalAlignment="Left" Width="140"
                                      Checked="OnVaultEnabledToggleChanged" Unchecked="OnVaultEnabledToggleChanged"/>

                        <TextBlock Text="Protection par mot de passe maitre" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="Si desactivee, le coffre s'ouvre directement sans demander de mot de passe. Les donnees restent chiffrees automatiquement (liees a votre session Windows)." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ToggleButton x:Name="VaultProtectionToggle" HorizontalAlignment="Left" Width="140"
                                      Checked="OnVaultProtectionToggleChanged" Unchecked="OnVaultProtectionToggleChanged"/>

                        <TextBlock Text="Delai avant frappe automatique" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="Temps laisse a la fenetre cible pour reprendre le focus, en millisecondes." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBox x:Name="DelayBox" Width="150" HorizontalAlignment="Left"/>

                        <TextBlock Text="Raccourci : recherche et frappe d'une entree" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="Cliquez dans le champ puis appuyez sur la nouvelle combinaison de touches." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBox x:Name="HotkeyBox" Width="280" HorizontalAlignment="Left"
                                 IsReadOnly="True" Focusable="True" PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                        <TextBlock Text="Raccourci : taper le contenu du presse-papiers" FontWeight="SemiBold" Margin="0,28,0,4"/>
                        <TextBlock Text="Tape directement le texte copie dans le presse-papiers, dans la fenetre active." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBox x:Name="ClipboardHotkeyBox" Width="280" HorizontalAlignment="Left"
                                 IsReadOnly="True" Focusable="True" PreviewKeyDown="OnClipboardHotkeyBoxPreviewKeyDown"/>

                        <Button x:Name="SaveSettingsButton" Content="Enregistrer" HorizontalAlignment="Left" Margin="0,28,0,0" Click="OnSaveSettingsClick"/>

                        <TextBlock x:Name="SettingsStatusText" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="Developpe par Lylian Fredon &#171; Daryu &#187; - tous droits reserves"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</Window>
