<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#ECECF2"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8D9E2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6A4CE0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5A3ED1"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1C23"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#63677A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D0342C"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B92A23"/>

</ResourceDictionary>
