<Window x:Class="Clacp.Views.EntryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entree" Height="540" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TITRE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="NOM D'UTILISATEUR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="UsernameBox" Grid.Row="3" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="4" Text="MOT DE PASSE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="PasswordBoxHidden" Grid.Column="0"/>
            <TextBox x:Name="PasswordBoxVisible" Grid.Column="0" Visibility="Collapsed"/>
            <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="1" Content="Afficher" Margin="8,0,0,0" Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged"/>
            <Button x:Name="GenerateButton" Grid.Column="2" Content="Generer" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="OnGenerateClick"/>
        </Grid>

        <TextBlock Grid.Row="6" Text="URL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="UrlBox" Grid.Row="7" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="8" Text="SEQUENCE DE FRAPPE AUTOMATIQUE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <ComboBox x:Name="AutoTypeCombo" Grid.Row="9" Margin="0,0,0,16">
            <ComboBoxItem Content="Utilisateur puis Tab puis mot de passe"/>
            <ComboBoxItem Content="Mot de passe uniquement"/>
        </ComboBox>

        <TextBlock Grid.Row="10" Text="NOTES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" VerticalAlignment="Top"/>
        <TextBox x:Name="NotesBox" Grid.Row="10" Margin="0,26,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnCancelClick"/>
            <Button x:Name="SaveButton" Content="Enregistrer" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
